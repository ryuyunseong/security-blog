{
  "type": "object",
  "additionalProperties": false,
  "required": ["articles", "withheld"],
  "properties": {
    "articles": {"type": "array", "items": {"$ref": "#/$defs/article"}},
    "withheld": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {"kind": {"enum": ["assessment", "qualys", "web", "infrastructure"]}, "reason": {"type": "string"}}
    }}
  },
  "$defs": {
    "article": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "slug", "title", "description", "tags", "body", "visual", "sources", "scope", "finding"],
      "properties": {
        "kind": {"enum": ["assessment", "qualys", "web", "infrastructure"]},
        "slug": {"type": "string"}, "title": {"type": "string"},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "body": {"type": "string"}, "scope": {"type": "string"}, "finding": {"type": "string"},
        "visual": {
          "type": "object", "additionalProperties": false,
          "required": ["title", "kind", "nodes", "note", "caption"],
          "properties": {
            "title": {"type": "string"}, "kind": {"enum": ["flow", "compare", "layers", "merge", "matrix", "timeline", "decision", "cycle", "topology", "intervals"]},
            "nodes": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
            "note": {"type": "string"}, "caption": {"type": "string"}
          }
        },
        "sources": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["title", "url", "quote"],
          "properties": {"title": {"type": "string"}, "url": {"type": "string"}, "quote": {"type": "string"}}
        }}
      }
    }
  }
}
