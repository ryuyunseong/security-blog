---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap((post) => post.data.tags))].map((tag) => ({ params: { tag }, props: { tag } }));
}
const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
---
<BaseLayout title={`${tag} 태그`} description={`${tag} 관련 정보보안 기술 노트`}>
  <div class="page-heading"><h1>#{tag}</h1><p>{tag} 태그가 달린 글 {posts.length}편입니다.</p></div><section class="page-section" aria-label={`${tag} 글 목록`}><PostList posts={posts} /></section>
</BaseLayout>
