---
import { getPosts } from '../../lib/posts';
import { postPath } from '../../lib/site';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { postId: post.id } }));
}

// 이미 공유한 그림 주소는 본문의 해당 그림으로 연결한다.
return Astro.redirect(`${postPath(Astro.props.postId)}#article-diagram`, 301);
---
