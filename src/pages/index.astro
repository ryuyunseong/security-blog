---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import TopicRail from '../components/TopicRail.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/posts';
import { siteInfo, unixSeries } from '../lib/site';
const posts = await getPosts();
---
<BaseLayout>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">보안 점검과 실습</h1>
    <p>{siteInfo.description}</p>
    <div class="intro-links"><a href="#posts">글 목록 보기<Icon name="arrow" /></a><a href={unixSeries.path}>주통기 점검 시리즈</a></div>
  </section>
  <div class="content-grid">
    <section id="posts" aria-labelledby="posts-title">
      <div class="section-heading"><h2 id="posts-title">최근 글</h2><span class="count">{posts.length}편</span></div>
      <PostList posts={posts} />
    </section>
    <TopicRail posts={posts} />
  </div>
</BaseLayout>
