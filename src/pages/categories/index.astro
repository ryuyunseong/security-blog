---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
import { categories, path } from '../../lib/site';
import AssessmentTargets from '../../components/AssessmentTargets.astro';
const posts = await getPosts();
---
<BaseLayout title="카테고리" description="주통기, Unix, 애플리케이션 보안, 인프라 보안, Qualys, 코딩 테스트 글 목록입니다.">
  <div class="page-heading"><h1>카테고리</h1><p>주제별 글 목록입니다.</p></div>
  <section class="page-section" aria-label="카테고리 목록"><ul class="category-index">{categories.map((category) => <li><a href={path(`categories/${category.id}/`)}><div><h2>{category.label}</h2><p>{category.description}</p></div><span class="count">{posts.filter((post) => post.data.category === category.id).length}편</span></a></li>)}</ul></section>
  <section class="page-section" aria-labelledby="assessment-targets-title"><h2 id="assessment-targets-title">주통기 점검 대상</h2><AssessmentTargets posts={posts} /></section>
</BaseLayout>
