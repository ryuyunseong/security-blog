---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
import { unixSeries } from '../../lib/site';
const posts = (await getPosts()).filter((post) => post.data.series === unixSeries.id)
  .sort((a, b) => a.data.seriesOrder! - b.data.seriesOrder!);
---
<BaseLayout title={unixSeries.title} description="주요정보통신기반시설 Unix 점검 글을 U 번호순으로 읽습니다. 현재 공개된 U-01부터 U-10까지의 계정 관리 항목을 모았습니다.">
  <header class="page-heading"><h1>주요정보통신기반시설<br />Unix 점검 시리즈</h1><p>2026년 가이드를 바탕으로, 확인할 설정과 판단의 한계를 기록합니다.</p></header>
  <section class="page-section" aria-labelledby="series-title">
    <p class="notice">현재 공개된 U-01~U-10 글 {posts.length}편을 번호순으로 모았습니다. 전체 Unix 점검 항목을 모두 다룬 시리즈는 아닙니다. 각 글의 Linux 예제와 다른 Unix 운영체제의 적용 범위를 구분해 읽어 주세요.</p>
    <div class="section-heading"><h2 id="series-title">계정 관리</h2><span class="count">{posts.length}편</span></div>
    <PostList posts={posts} />
    <p class="source-note">기준 자료: <a href="https://www.krcert.or.kr/kr/bbs/view.do?bbsId=B0000127&amp;menuNo=205021&amp;nttId=71928">KISA 주요정보통신기반시설 기술적 취약점 분석·평가 방법 상세가이드</a>. 세부 판단은 해당 문서와 사용하는 운영체제·버전을 함께 확인합니다.</p>
  </section>
</BaseLayout>
