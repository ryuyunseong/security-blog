---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel, dateLabel, path, postPath, tagPath } from '../lib/site';
import Icon from './Icon.astro';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => <li class="post-row">
    <div class="post-category"><a href={path(`categories/${post.data.category}/`)}>{categoryLabel(post.data.category)}</a>{post.data.example && <span class="example-label">예제 글</span>}</div>
    <div class="post-summary">
      <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
      <h3><a href={postPath(post.id)}>{post.data.title}</a></h3>
      <p>{post.data.description}</p>
      <div class="tags">{post.data.tags.map((tag) => <a href={tagPath(tag)}>{tag}</a>)}</div>
    </div>
    <a class="post-arrow" href={postPath(post.id)} aria-label={`${post.data.title} 읽기`} tabindex="-1"><Icon name="arrow" /></a>
  </li>)}
</ul>
{posts.length === 0 && <p class="empty-state">아직 공개된 글이 없습니다.</p>}
