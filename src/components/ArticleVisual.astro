---
import visuals from '../data/article-visuals.json';
import { path } from '../lib/site';
import ResponsiveDiagram from './ResponsiveDiagram.astro';
interface Props { id: string; kind?: 'diagram' | 'photo'; }
const { id, kind = 'diagram' } = Astro.props;
const visual = visuals[id as keyof typeof visuals];
const photo = visual && 'photo' in visual ? visual.photo : undefined;
---
{visual && kind === 'diagram' && <figure id="article-diagram" class="article-visual">
  <ResponsiveDiagram id={id} />
  <figcaption>{visual.caption}</figcaption>
</figure>}
{photo && kind === 'photo' && <figure class="article-photo">
  <img src={path(photo.src)} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
  <figcaption>{photo.caption}</figcaption>
</figure>}
